# guacamole-plasma-wayland configuration.
# install.sh copies this file to ~/.config/guacamole-plasma/config.env (chmod 600) and fills every
# empty secret with a strong random value. Edit that copy, never this example.

# Web login user and password (password generated when empty)
GP_USER=admin
GP_PASS=

# Two-factor authentication (Time-based One-Time Password)
GP_TOTP=true
GP_TOTP_ISSUER="Guacamole Plasma"
GP_TOTP_SECRET=

# Internal secrets (generated when empty)
GP_DB_PASS=
GP_VNC_PASS=
GP_SSH_PASSPHRASE=

# Where the web interface is published: 127.0.0.1 (local reverse proxy), a Tailscale/LAN address of this
# machine, or 0.0.0.0 (then protect the port with a firewall). Use a reverse proxy with TLS in front.
GP_BIND=127.0.0.1
GP_PORT=8087

# Regular expression of reverse proxies allowed to send X-Forwarded-For (real client IP for the ban)
GP_TRUSTED_PROXY='127\.0\.0\.1'

# Branding: name shown instead of "Apache Guacamole" and optional PNG logo (light logos look best)
GP_APP_NAME="Remote Desktop"
GP_LOGO=

# Components
GP_DESKTOP=true
GP_SSH=true

# Names and versions
GP_POD=guac
GP_GUAC_VERSION=1.6.0
GP_POSTGRES_IMAGE=docker.io/library/postgres:16-alpine
